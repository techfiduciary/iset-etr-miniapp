# ── ISET eTR MiniApp — front-end env (Vite, prefix VITE_) ──────────────────────
# The sovereign issuer + registry. The MiniApp NEVER signs records itself.
VITE_ISET_API_BASE=https://iset.finance

# Celo network: 11142220 = Celo Sepolia testnet, 42220 = mainnet.
# Test on Celo Sepolia first (Alfajores is deprecated). Mainnet only after counsel sign-off.
VITE_CELO_CHAIN_ID=11142220

# Deployed contract addresses (fill after `contracts` deploy — see contracts/README).
# Leave blank to keep the on-chain buttons inert with a "deploy contracts first" notice.
VITE_ANCHOR_ADDRESS=
VITE_ETRNOTE_ADDRESS=

# Settlement stablecoin (defaults baked in per chain in src/lib/chain.ts; override if needed)
VITE_SETTLE_TOKEN_ADDRESS=
